# CompSynth 环境变量配置
# 复制此文件为 .env 并填入实际值

# ---- 路径配置 ----
COMPSYNTH_LOG_DIR=./logs
COMPSYNTH_DATA_DIR=./data

# ---- LLM 配置 ----
# OpenAI（使用 OpenAI 兼容接口的模型也用这个）
COMPSYNTH_OPENAI_API_KEY=
COMPSYNTH_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic（支持 Claude 系列）
COMPSYNTH_ANTHROPIC_API_KEY=
COMPSYNTH_ANTHROPIC_BASE_URL=

# 默认使用 gpt-4o-mini，Anthropic 模型如 claude-sonnet-4-20250514
COMPSYNTH_MODEL=gpt-4o-mini

# ---- 存储配置 ----
COMPSYNTH_CHROMA_PERSIST_DIR=./data/chroma
COMPSYNTH_CRAWL_DB_PATH=./data/crawl_state.db
COMPSYNTH_SITE_SCHEMA_DB_PATH=./data/site_schemas.db
COMPSYNTH_VECTOR_TTL_DAYS=30

# ---- 爬虫配置 ----
COMPSYNTH_REQUEST_TIMEOUT=30
COMPSYNTH_MAX_CONCURRENT_REQUESTS=5
COMPSYNTH_LIST_PAGE_TIME_THRESHOLD_DAYS=7
COMPSYNTH_LIST_PAGE_COUNT_THRESHOLD=20

# ---- 选择器健康刷新（可选） ----
COMPSYNTH_SELECTOR_ZERO_REFRESH_ENABLED=true
COMPSYNTH_SELECTOR_ZERO_REFRESH_DAYS=3
COMPSYNTH_SELECTOR_ZERO_REFRESH_LOOKBACK_DAYS=7
COMPSYNTH_SELECTOR_ZERO_REFRESH_COOLDOWN_HOURS=24

# ---- 订阅与输出配置 ----
COMPSYNTH_SUBSCRIPTIONS_PATH=./subscriptions.yaml
COMPSYNTH_OUTPUT_DIR=./output
