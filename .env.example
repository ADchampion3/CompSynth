# CompSynth 环境变量配置
# 复制此文件为 .env 并填入实际值

# ---- 路径配置 ----
COMPSYNTH_LOG_DIR=./logs
COMPSYNTH_DATA_DIR=./data

# ---- LLM 配置 ----
COMPSYNTH_OPENAI_API_KEY=
COMPSYNTH_OPENAI_BASE_URL=https://api.openai.com/v1
COMPSYNTH_ANTHROPIC_API_KEY=
COMPSYNTH_MODEL=gpt-4o-mini

# ---- 存储配置 ----
COMPSYNTH_CHROMA_PERSIST_DIR=./data/chroma
COMPSYNTH_CRAWL_DB_PATH=./data/crawl_state.db
COMPSYNTH_VECTOR_TTL_DAYS=30

# ---- 爬虫配置 ----
COMPSYNTH_REQUEST_TIMEOUT=30 # 以秒为单位(s)
COMPSYNTH_MAX_CONCURRENT_REQUESTS=5
COMPSYNTH_RSS_LOOKBACK_DAYS=7

# ---- 订阅与输出配置 ----
COMPSYNTH_SUBSCRIPTIONS_PATH=./subscriptions.yaml
COMPSYNTH_OUTPUT_DIR=./output
